{
  "manifestVersion": 2,
  "id": "rose-pine",
  "name": "Rosé Pine for Orca",
  "version": "0.1.1",
  "execution": "data",
  "description": "All natural pine, faux fur and a bit of soho vibes: Rosé Pine, Moon and Dawn as app and terminal themes, with matching syntax colors.",
  "license": "MIT",
  "repository": "https://github.com/thailoc-dev/orca-rose-pine",
  "engines": {
    "orca": ">=1.4.246"
  },
  "contributes": {
    "themes": [
      {
        "id": "rose-pine",
        "title": "Rosé Pine",
        "path": "themes/rose-pine.json"
      },
      {
        "id": "rose-pine-moon",
        "title": "Rosé Pine Moon",
        "path": "themes/rose-pine-moon.json"
      },
      {
        "id": "rose-pine-dawn",
        "title": "Rosé Pine Dawn",
        "path": "themes/rose-pine-dawn.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "rose-pine",
        "title": "Rosé Pine",
        "path": "terminal/rose-pine.json"
      },
      {
        "id": "rose-pine-moon",
        "title": "Rosé Pine Moon",
        "path": "terminal/rose-pine-moon.json"
      },
      {
        "id": "rose-pine-dawn",
        "title": "Rosé Pine Dawn",
        "path": "terminal/rose-pine-dawn.json"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "Orca in Rosé Pine, Rosé Pine Moon and Rosé Pine Dawn, each showing workspaces, syntax-highlighted TypeScript and a terminal"
  }
}
